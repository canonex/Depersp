{
    "name": "crickyx/depersp",
    "description": "Automatic perspective correction of photographed sheets with a dark frame. Pure PHP + Imagick, no shell commands.",
    "type": "library",
    "keywords": ["perspective", "deskew", "rectify", "document", "scan", "imagick", "image"],
    "license": "GPL-3.0-or-later",
    "authors": [
        { "name": "Riccardo Gagliarducci" }
    ],
    "require": {
        "php": ">=8.1",
        "ext-imagick": "*",
        "ext-fileinfo": "*"
    },
    "autoload": {
        "psr-4": { "Depersp\\": "src/" }
    },
    "bin": ["bin/depersp"],
    "scripts": {
        "test": "php -d memory_limit=512M tests/run.php"
    },
    "config": {
        "sort-packages": true
    }
}
