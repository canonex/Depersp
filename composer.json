{
    "name": "crickyx/depersp",
    "description": "Automatic perspective correction of photographed framed sheets, in pure PHP + Imagick.",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.1",
        "ext-imagick": "*",
        "ext-fileinfo": "*"
    },
    "autoload": {
        "psr-4": { "Depersp\\": "src/" }
    },
    "bin": ["bin/depersp"],
    "scripts": {
        "test": "php -d memory_limit=512M tests/run.php"
    }
}
